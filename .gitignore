# ============================================================
# AI 智能客服项目根 .gitignore（统一管理前后端忽略规则）
# ============================================================

# ---- 通用：日志 ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 通用：操作系统文件 ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- 通用：环境变量与密钥（防止泄露）----
.env
.env.local
.env.*.local
application-local.yaml
application-local.yml
application-secret.yaml

# ---- IDE：IntelliJ IDEA / WebStorm ----
.idea/
*.iml
*.iws
*.ipr
out/

# ---- IDE：VS Code（保留 extensions.json 用于团队插件同步）----
.vscode/*
!.vscode/extensions.json

# ---- IDE：Eclipse / STS ----
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# ---- IDE：NetBeans ----
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ============================================================
# 前端（ai-chat-front）
# ============================================================
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ============================================================
# 后端（ai-chat-backend）
# ============================================================
# Maven 构建产物
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven Wrapper jar（按 Spring Initializr 默认策略忽略，clone 后由 mvnw 自动下载）
.mvn/wrapper/maven-wrapper.jar

# Spring Initializr 默认帮助文档（已被本项目的 README 替代）
HELP.md

# Java 编译产物与运行时文件
*.class
*.jar
hs_err_pid*
replay_pid*

# 临时文件
*.tmp
*.bak
*.swp
*.orig
